<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      技术栈与 seeky-ai-runtime 完全一致（AgentScope 2.0.3 基于 Spring Boot 4.0.x 构建），
      业务分层与 seeky-app-server 一致（controller / service / repository 三层 + Result 信封）。
      两个项目合并为一个进程：不再有 ai-runtime / app-server 的拆分。

      差异只有一处（需求明确要求）：提示词与技能不放 Nacos Prompt/Skill Registry，
      改为 classpath:prompts / classpath:skills 下的本地文件，启动时一次性载入内存。
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.4</version>
        <relativePath/>
    </parent>

    <groupId>com.seeky</groupId>
    <artifactId>ai-soulmate-server</artifactId>
    <version>1.0.0</version>
    <name>ai-soulmate-server</name>
    <description>AI 陪伴数字人后端：AgentScope 2.x + Spring AI Alibaba StateGraph，单服务交付</description>

    <properties>
        <java.version>21</java.version>
        <agentscope.version>2.0.3</agentscope.version>
        <spring-cloud-alibaba.version>2025.1.0.0</spring-cloud-alibaba.version>
        <spring-cloud.version>2025.1.0</spring-cloud.version>
        <spring-ai-alibaba.version>2.0.0-M1.1</spring-ai-alibaba.version>
        <springdoc.version>3.1.1</springdoc.version>
        <!-- 本地 m2 里只有 0.11.5，别升到 0.12.x（离线构建会挂） -->
        <jjwt.version>0.11.5</jjwt.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.agentscope</groupId>
                <artifactId>agentscope-dependencies-bom</artifactId>
                <version>${agentscope.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- WebFlux：AgentScope 全链路基于 Reactor，流式对话直接以 SSE 返回 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- AgentScope：ReActAgent / 事件流 / Toolkit / Skill 模型 -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-core</artifactId>
            <version>${agentscope.version}</version>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-model-dashscope</artifactId>
            <version>${agentscope.version}</version>
        </dependency>

        <!-- Spring AI Alibaba StateGraph：主对话图编排（节点内仍调 AgentScope Model） -->
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-graph-core</artifactId>
            <version>${spring-ai-alibaba.version}</version>
        </dependency>

        <!-- 本地持久化：PostgreSQL（本机 5432，库名 ai-soulmate）。
             连接池用 HikariCP，存储层自己持有 DataSource（见 store/PgStore），
             不引 spring-boot-starter-jdbc —— 只需要一个 pool + 原生 JDBC，不需要 JPA/事务管理。 -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
        </dependency>

        <!-- 鉴权：JWT 签发与校验（HS256）。
             只引 jjwt，不引 spring-boot-starter-security —— 这是个单用户陪伴 Demo，
             不需要 filter chain / CSRF / 表单登录那一整套，一个 WebFilter 足够。 -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>build-info</id>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
