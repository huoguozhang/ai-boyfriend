# ============================================================
# 配置模板：复制成 .env 再填值
#   cp .env.example .env
# .env 已在 .gitignore 里，真实 Key 只写 .env，绝不提交。
# ============================================================

# ---------- 服务 ----------
# 6000 段（8080 是本机 Nacos）
PORT=6100
# 本地 mem0 服务端口，见 docs/BACKEND-PLAN.md §7
MEM0_PORT=6101

# ---------- 大模型：火山方舟 Agent Plan ----------
LLM_ENABLED=true
LLM_PROTOCOL=openai
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
LLM_API_KEY=
LLM_MODEL=ark-code-latest

# ---------- 语音识别 ----------
# 前端把录音转成 16k 单声道 WAV 的 Base64 发过来，这里同步返回文字。
# ASR_PROTOCOL 三选一：
#   ark        —— 方舟多模态（推荐）：音频当 input_audio 发 chat/completions，
#                 与 LLM_API_KEY 共用同一把 ark Key，不用另外申请凭据。
#   volcengine —— 火山「语音技术」录音文件识别极速版：Key 要在「豆包语音」控制台单独签发，
#                 与 ark Key 不通用，且要开通对应档位，否则 45000000 鉴权失败。
#   mock       —— 演示：返回固定文本（前端不会把它当成你说的话发出去）。
ASR_ENABLED=true
ASR_PROTOCOL=ark
ASR_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
ASR_API_KEY=
ASR_MODEL=doubao-seed-2-1-lite-260915
# 仅 volcengine 协议用：极速版 volc.bigasr.auc_turbo / 标准版 volc.seedasr.auc
ASR_RESOURCE_ID=volc.bigasr.auc_turbo

# ---------- 语音合成（火山豆包语音合成 2.0） ----------
# TTS_PROTOCOL: volcengine（火山 HTTP 单向流式） | mock（出提示音，链路仍可验收）
# Agent Plan 的专属 Key 与 LLM_API_KEY 是同一个，不需要另开豆包语音的 appid / access_token
TTS_ENABLED=true
TTS_PROTOCOL=mock
TTS_BASE_URL=https://openspeech.bytedance.com/api/v3/plan/tts/unidirectional
TTS_API_KEY=
TTS_MODEL=doubao-seed-tts-2.0
# 音色与 resource id 必须配套：*_uranus_bigtts / *_moon_bigtts 是 2.0 音色（seed-tts-2.0）
TTS_VOICE=zh_female_gaolengyujie_uranus_bigtts
TTS_RESOURCE_ID=seed-tts-2.0
# 音频参数（默认 mp3 / 24000Hz / 160kbps / 600 字上限），一般不用改
# TTS_BIT_RATE=160000
# TTS_FORMAT=mp3
# TTS_SAMPLE_RATE=24000
# TTS_MAX_TEXT_LENGTH=600

# ---------- 图像生成 ----------
IMAGE_ENABLED=true
IMAGE_PROTOCOL=mock
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=

# ---------- 视频生成 ----------
VIDEO_ENABLED=true
VIDEO_PROTOCOL=mock
VIDEO_BASE_URL=
VIDEO_API_KEY=
VIDEO_MODEL=

# ---------- 记忆 ----------
# 记忆的唯一权威是 mem0（memory-service/）；PostgreSQL 只存 sessions / messages
MEMORY_ENABLED=true
# 本地起：http://127.0.0.1:6101
# 用服务器上那份：http://101.43.26.29/mem0（nginx 反代到 6101，服务器只对外开了 80）
MEM0_BASE_URL=http://127.0.0.1:6101
# 服务器版 .env 里生成的那个 32 位 key，连远程必须填
MEM0_API_KEY=
MEM0_AGENT_ID=xiaoman
MEM0_SEARCH_LIMIT=8
MEM0_MAX_CONTEXT_CHARS=4096

# ---------- 角色卡 ----------
PERSONA_NAME=小满
PERSONA_AGE=24
PERSONA_CITY=杭州
PERSONA_JOB=插画师
PERSONA_PERSONALITY=嘴硬心软，嘴上嫌弃但会记住你说过的话
PERSONA_SPEAKING_STYLE=短句，像微信聊天，偶尔用语气词
PERSONA_BACKSTORY=你们认识两年了，住得不远，她有自己的工作和生活
PERSONA_PET_NAME=布丁
PERSONA_VOICE_HINT=年轻女声，语速稍快，带一点懒散

# ---------- 鉴权（JWT） ----------
# HS256 签名密钥，≥32 字节。换掉它 = 所有已登录用户立刻掉线（无状态 JWT 的代价）
# 生成：openssl rand -base64 48   （留空也能跑，但重启会踢掉所有人，所以配一把固定的）
JWT_SECRET=
# token 有效期（秒）：7 天
JWT_TTL=604800
JWT_ISSUER=ai-soulmate
PBKDF2_ITERATIONS=210000

# ---------- 聊天偏好 ----------
# CHAT_RECEIVE_MODE: text | voice | both
CHAT_RECEIVE_MODE=both
CHAT_AUTO_PLAY=true
CHAT_PROACTIVE=true
CHAT_HISTORY_LIMIT=24

# ---------- 存储（PostgreSQL，只放业务数据：sessions / messages） ----------
# 本机库已在 5432 建好（库名带连字符，JDBC URL 里可以直接写）；pg_hba 是 trust，密码留空
PG_URL=jdbc:postgresql://127.0.0.1:5432/ai-soulmate
PG_USERNAME=zlj
PG_PASSWORD=
PG_POOL_SIZE=4
