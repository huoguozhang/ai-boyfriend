# ============================================================
# 服务器版 mem0（postgres + pgvector）配置：复制成 .env
#   cp .env.pg.example .env
#   docker compose -f compose.pg.yaml up -d --build
# 主服务的 server/.env 里用 MEM0_BASE_URL 指向这里。
# ============================================================

# 调用方必须带 X-API-Key；留空 = 不校验（公网服务器上别留空）
MEM0_API_KEY=

# mem0 的身份维度：agent_id 固定，用户维度用 user_id，会话维度用 run_id
MEM0_AGENT_ID=xiaoman
MEM0_COLLECTION=memories
MEM0_SEARCH_LIMIT=8

# 向量库：服务器用 pgvector（本地 compose.yaml 默认 faiss）
MEM0_VECTOR_STORE=pgvector

# postgres：密码必须改，PG_PASSWORD 没配时 compose 会直接拒绝启动
PG_HOST=postgres
PG_PORT=5432
PG_USER=mem0
PG_PASSWORD=change-me-please
PG_DB=mem0

# 向量化：本地 ONNX 模型，零 Key、不联网（构建时已预下载）
# bge-small-zh-v1.5 实际输出 512 维，与 postgres 里 vector(512) 必须一致
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMS=512

# history.db（变更史）落在容器内这个目录，compose 已挂到 ./data
MEM0_DATA_DIR=/data
