# ============================================================
# 本地 mem0 服务配置：复制成 .env
#   cp .env.example .env
# 主服务的 server/.env 里用 MEM0_BASE_URL 指向这里。
# ============================================================

# 宿主端口由 compose.yaml 的 ports 决定（6101），这里只配容器内行为

# 调用方必须带 X-API-Key；留空 = 本机不校验（只适合本地面板/演示）
MEM0_API_KEY=

# mem0 的身份维度：agent_id 固定，用户维度用 user_id，会话维度用 run_id
MEM0_AGENT_ID=xiaoman
# 单次检索默认条数（调用方可用 top_k 覆盖）
MEM0_SEARCH_LIMIT=8

# 向量化：本地 ONNX 模型，零 Key、不联网（构建时已预下载）
# bge-small-zh-v1.5 实际输出 512 维（不是 384，配错 faiss 会在写入时报维度不符）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMS=512

# 数据目录（容器内路径，compose 已挂到 ./data）
MEM0_DATA_DIR=/data
